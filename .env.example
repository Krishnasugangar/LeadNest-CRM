# Local Docker Compose values. Copy this file to .env and change the admin password.
# These values are for a private machine only. The application never hardcodes them.

MYSQL_ROOT_PASSWORD=leadnest-root
MYSQL_PASSWORD=leadnest

LEADNEST_ADMIN_NAME=Avery Admin
LEADNEST_ADMIN_EMAIL=admin@leadnest.local
LEADNEST_ADMIN_PASSWORD=Admin@123

# Optional fictional sample leads. Leave false unless you want them.
LEADNEST_DEMO_DATA=false
